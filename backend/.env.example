# Copy to .env and fill in real values. .env itself is never tracked.

# App
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Database. 5433, not 5432: a native Postgres commonly already sits on
# 5432 on a dev machine, see docker-compose.yml. Inside docker-compose
# itself, the api/worker services override this to postgres:5432 on
# the internal network, this value is for running things directly on
# the host (alembic, pytest, uvicorn without Docker).
DATABASE_URL=postgresql+asyncpg://kobo:kobo@localhost:5433/kobo_dev

# Redis (cache, rate limiting, sessions, Celery broker). 6380, not
# 6379: a native Redis commonly already sits on 6379 on a dev machine,
# same reasoning as the database port above. Overridden to redis:6379
# inside docker-compose itself.
REDIS_URL=redis://localhost:6380/0

# Sessions
SESSION_COOKIE_NAME=kc_session
SESSION_TTL_SECONDS=1209600

# Email (Mailtrap: sandbox in development, sending API in production)
MAILTRAP_API_TOKEN=
MAILTRAP_SANDBOX_INBOX_ID=

# Payments (not needed until Stage 2 of the monetization plan)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Bot mitigation
TURNSTILE_SECRET_KEY=

# Observability
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Market data
ALPHA_VANTAGE_API_KEY=
# NG data and any US metric gap, per docs/backend-architecture/00.md's
# LLM research agent mechanism
ANTHROPIC_API_KEY=
